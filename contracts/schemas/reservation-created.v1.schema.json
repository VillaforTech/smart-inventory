{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "inventory.stock-reserved.v1",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "inventory.stock-reserved"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|\\+00:00)$"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "producer": {
      "const": "smart-inventory"
    },
    "payload": {
      "type": "object",
      "properties": {
        "reservationId": {
          "type": "string",
          "format": "uuid"
        },
        "sku": {
          "type": "string",
          "minLength": 1
        },
        "qty": {
          "type": "integer",
          "minimum": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "lots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "lot": {
                "type": "string",
                "minLength": 1
              },
              "qty": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "lot",
              "qty"
            ]
          }
        }
      },
      "required": [
        "reservationId",
        "sku",
        "qty",
        "location",
        "lots"
      ]
    }
  },
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "correlationId",
    "producer",
    "payload"
  ]
}
